{
  "id": "fluxcuda",
  "name": "FLUX.1 schnell (GGUF)",
  "kind": "text2image",
  "version": "1.0.1",
  "install_version": "1.0.0",
  "min_program": "1.3.17",
  "only": "nvidia",
  "description": "Draws the subject you describe on this computer with its NVIDIA card, with faithful shapes and anatomy, ready for the 3D engines: free and offline after installation (the translation of the description is downloaded the first time).",
  "license": "FLUX.1 [schnell]: Apache 2.0, commercial use allowed (Black Forest Labs); translation: OPUS-MT, CC BY 4.0 (University of Helsinki)",
  "homepage": "https://huggingface.co/black-forest-labs/FLUX.1-schnell",
  "download_gb": 16.6,
  "minutes": "10-30 seconds per picture on NVIDIA cards with 8 GB or more",
  "steps": [
    {
      "label": "PyTorch (computing engine)",
      "pkgs": [
        "torch"
      ],
      "win_nvidia": [
        "--index-url",
        "https://download.pytorch.org/whl/cu124",
        "--extra-index-url",
        "https://pypi.org/simple"
      ]
    },
    {
      "label": "image generator",
      "alternatives": [
        [
          "diffusers>=0.32,<0.36",
          "transformers>=4.45,<5",
          "accelerate",
          "safetensors",
          "gguf>=0.10",
          "sentencepiece",
          "protobuf",
          "sacremoses",
          "Pillow",
          "huggingface-hub<1.0"
        ],
        [
          "diffusers",
          "transformers",
          "accelerate",
          "safetensors",
          "gguf",
          "sentencepiece",
          "protobuf",
          "sacremoses",
          "Pillow",
          "huggingface-hub<1.0"
        ]
      ]
    }
  ],
  "weights_sets": [
    {
      "hf_repo": "ostris/OpenFLUX.1",
      "subdir": "base",
      "files": [
        "model_index.json",
        "scheduler/scheduler_config.json",
        "text_encoder/config.json",
        "text_encoder/model.safetensors",
        "text_encoder_2/config.json",
        "text_encoder_2/model-00001-of-00002.safetensors",
        "text_encoder_2/model-00002-of-00002.safetensors",
        "text_encoder_2/model.safetensors.index.json",
        "tokenizer/merges.txt",
        "tokenizer/special_tokens_map.json",
        "tokenizer/tokenizer_config.json",
        "tokenizer/vocab.json",
        "tokenizer_2/special_tokens_map.json",
        "tokenizer_2/spiece.model",
        "tokenizer_2/tokenizer.json",
        "tokenizer_2/tokenizer_config.json",
        "transformer/config.json",
        "vae/config.json",
        "vae/diffusion_pytorch_model.safetensors"
      ]
    },
    {
      "hf_repo": "city96/FLUX.1-schnell-gguf",
      "subdir": "gguf",
      "files": [
        "flux1-schnell-Q4_K_S.gguf"
      ]
    }
  ],
  "runner": "runner.py",
  "options": [
    {
      "id": "quality",
      "label": "Picture quality",
      "type": "choice",
      "default": "normal",
      "choices": [
        [
          "draft",
          "Fast"
        ],
        [
          "normal",
          "Normal"
        ],
        [
          "high",
          "High (slower)"
        ]
      ]
    },
    {
      "id": "symmetric",
      "label": "Symmetric subject",
      "type": "hidden",
      "default": "0"
    }
  ],
  "order": 59
}
