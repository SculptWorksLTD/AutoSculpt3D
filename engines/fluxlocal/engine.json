{
  "id": "fluxlocal",
  "name": "FLUX.1 schnell (MLX)",
  "kind": "text2image",
  "version": "1.0.0",
  "install_version": "1.0.0",
  "min_program": "1.3.16",
  "only": "apple_chip",
  "description": "Draws the subject you describe on this Mac, with faithful shapes and anatomy, ready for the 3D engines: free and offline after installation (the translation of the description is downloaded the first time).",
  "license": "FLUX.1 [schnell]: Apache 2.0, commercial use allowed (Black Forest Labs); mflux: MIT; translation: OPUS-MT, CC BY 4.0 (University of Helsinki)",
  "homepage": "https://huggingface.co/black-forest-labs/FLUX.1-schnell",
  "download_gb": 9.6,
  "minutes": "about 1 minute per picture on Apple chips with 16 GB",
  "steps": [
    {
      "label": "image generator",
      "pkgs": [
        "mflux==0.6.2",
        "sacremoses"
      ]
    }
  ],
  "weights": {
    "hf_repo": "dhairyashil/FLUX.1-schnell-mflux-v0.6.2-4bit",
    "files": [
      "config.json",
      "text_encoder/0.safetensors",
      "text_encoder_2/0.safetensors",
      "text_encoder_2/1.safetensors",
      "tokenizer/merges.txt",
      "tokenizer/special_tokens_map.json",
      "tokenizer/tokenizer_config.json",
      "tokenizer/vocab.json",
      "tokenizer_2/added_tokens.json",
      "tokenizer_2/special_tokens_map.json",
      "tokenizer_2/spiece.model",
      "tokenizer_2/tokenizer_config.json",
      "transformer/0.safetensors",
      "transformer/1.safetensors",
      "transformer/2.safetensors",
      "transformer/3.safetensors",
      "vae/0.safetensors"
    ]
  },
  "runner": "runner.py",
  "options": [
    {
      "id": "quality",
      "label": "Picture quality",
      "type": "choice",
      "default": "normal",
      "choices": [
        [
          "draft",
          "Fast"
        ],
        [
          "normal",
          "Normal"
        ],
        [
          "high",
          "High (slower)"
        ]
      ]
    },
    {
      "id": "symmetric",
      "label": "Symmetric subject",
      "type": "hidden",
      "default": "0"
    }
  ],
  "order": 59
}
