{
  "id": "whisper",
  "name": "Whisper (voice)",
  "kind": "speech2text",
  "version": "1.1.3",
  "install_version": "1.1.0",
  "description": "Writes the description you dictate with the microphone, on this computer: free, private and offline after installation.",
  "license": "MIT, commercial use allowed (OpenAI Whisper large-v3-turbo)",
  "homepage": "https://huggingface.co/openai/whisper-large-v3-turbo",
  "download_gb": 1.8,
  "minutes": "a few seconds per sentence",
  "steps": [
    {
      "label": "PyTorch (computing engine)",
      "pkgs": [
        "torch"
      ],
      "win_nvidia": [
        "--index-url",
        "https://download.pytorch.org/whl/cu124",
        "--extra-index-url",
        "https://pypi.org/simple"
      ]
    },
    {
      "label": "speech recognition",
      "alternatives": [
        [
          "transformers>=4.40,<4.50",
          "numpy",
          "safetensors",
          "huggingface-hub<1.0"
        ],
        [
          "transformers",
          "numpy",
          "safetensors",
          "huggingface-hub<1.0"
        ]
      ]
    }
  ],
  "weights": {
    "hf_repo": "openai/whisper-large-v3-turbo",
    "files": [
      "added_tokens.json",
      "config.json",
      "generation_config.json",
      "merges.txt",
      "model.safetensors",
      "normalizer.json",
      "preprocessor_config.json",
      "special_tokens_map.json",
      "tokenizer.json",
      "tokenizer_config.json",
      "vocab.json"
    ]
  },
  "runner": "runner.py",
  "order": 50
}
